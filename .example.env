TOKEN= api key for resend (used to send verification emails)
CAPTCHA= google captcha key
CLOUDINAPI=cloudinary api
CLOUDINSEC= cloudinary security key
CLOUDINNAME= cloudinary name
ADMINPASS= admin password
ADMINEMAIL= admin email
SESSION= salt for making session
ALLOWED=http://localhost:3069 //optional
THIRDALLOWED= domains allowed to send req to your routes , eg-abc.com
FOURTHALLOWED= domains allowed to send req to your routes , eg-abc.com
GOOGLE_CLIENT_ID= google oauth api id
GOOGLE_CLIENT_SECRET= google oauth api secret key
NODE_ENV=product // keep it same
SUPABASE_URL= short url for supabase db
SUPABASE_DB_URL= long string url for supabase
SUPABASE_KEY= key for supabase 
SERVER_URL=https://localhost:3069
REDIS_URL= url for redis  
CREDENTIALS_SECRET= salt used for encrpyting credentials 
GEMINI_KEY= gemini api key